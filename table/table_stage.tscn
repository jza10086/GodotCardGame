[sub_resource type="Shader" id="DropShader"]
code = "shader_type spatial;
render_mode unshaded, depth_draw_never, cull_disabled;
void fragment() {
	float d = length(UV - vec2(0.5)) * 2.0;
	float ring = smoothstep(0.62, 0.82, d) * (1.0 - smoothstep(0.84, 1.0, d));
	ALBEDO = vec3(0.87, 0.74, 0.43);
	ALPHA = ring * 0.56 + (1.0 - smoothstep(0.34, 0.80, d)) * 0.12;
}"

