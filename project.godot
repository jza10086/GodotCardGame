config_version=5
[application]
config/name="Spectrum / 彩序 · 3D 卡牌"
run/main_scene="res://scenes/card_lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=960
window/size/window_width_override=1440
window/size/window_height_override=960
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.064,0.082,1)

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4

[autoload]
CardSession="*res://scripts/card_session.gd"
